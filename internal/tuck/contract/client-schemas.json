{
  "definitions": {
    "PlatformEnrollmentMaterial": {
      "description": "Versioned native scan/paste material; not an HTTP enrollment request. See Control Protocol section 8. The explicit deployment public HTTP/HTTPS origin is used, never the browser origin or an internal Hub/Relay address.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "formatVersion",
        "kind",
        "platformUrl",
        "code",
        "expiresAt"
      ],
      "properties": {
        "formatVersion": {
          "type": "integer",
          "enum": [
            1
          ]
        },
        "kind": {
          "type": "string",
          "enum": [
            "PLATFORM_ENROLLMENT"
          ]
        },
        "platformUrl": {
          "type": "string",
          "format": "uri",
          "maxLength": 1024
        },
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}[Tt](?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d{1,9})?(?:[Zz]|\\+00:00)$"
        }
      }
    },
    "Discovery": {
      "type": "object",
      "required": [
        "product",
        "protocolVersion",
        "deploymentId",
        "deploymentName",
        "clientApiBase",
        "runtimeApiBase",
        "supportedSnapshotSchemaVersions"
      ],
      "properties": {
        "product": {
          "type": "string",
          "enum": [
            "MEASIX_AGENT_PLATFORM"
          ]
        },
        "protocolVersion": {
          "type": "string",
          "enum": [
            "1"
          ]
        },
        "deploymentId": {
          "$ref": "#/definitions/DeploymentId"
        },
        "deploymentName": {
          "type": "string"
        },
        "clientApiBase": {
          "type": "string",
          "pattern": "^/"
        },
        "runtimeApiBase": {
          "type": "string",
          "pattern": "^/"
        },
        "supportedSnapshotSchemaVersions": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        }
      }
    },
    "DeploymentId": {
      "type": "string",
      "pattern": "^dep_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "EnrollmentExchangeResponse": {
      "type": "object",
      "required": [
        "deploymentId",
        "userId",
        "deviceId",
        "sessionId",
        "accessToken",
        "accessTokenExpiresAt",
        "refreshToken",
        "refreshExpiresAt",
        "sessionIdleExpiresAt"
      ],
      "properties": {
        "deploymentId": {
          "$ref": "#/definitions/DeploymentId"
        },
        "userId": {
          "$ref": "#/definitions/UserId"
        },
        "deviceId": {
          "$ref": "#/definitions/DeviceId"
        },
        "sessionId": {
          "$ref": "#/definitions/SessionId"
        },
        "accessToken": {
          "type": "string"
        },
        "accessTokenExpiresAt": {
          "type": "string",
          "format": "date-time"
        },
        "refreshToken": {
          "type": "string"
        },
        "refreshExpiresAt": {
          "type": "string",
          "format": "date-time"
        },
        "sessionIdleExpiresAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "UserId": {
      "type": "string",
      "pattern": "^usr_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "DeviceId": {
      "type": "string",
      "pattern": "^dev_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "SessionId": {
      "type": "string",
      "pattern": "^ses_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "RefreshResponse": {
      "type": "object",
      "required": [
        "accessToken",
        "accessTokenExpiresAt",
        "refreshToken",
        "refreshExpiresAt",
        "sessionIdleExpiresAt"
      ],
      "properties": {
        "accessToken": {
          "type": "string"
        },
        "accessTokenExpiresAt": {
          "type": "string",
          "format": "date-time"
        },
        "refreshToken": {
          "type": "string"
        },
        "refreshExpiresAt": {
          "type": "string",
          "format": "date-time"
        },
        "sessionIdleExpiresAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "Bootstrap": {
      "type": "object",
      "required": [
        "deployment",
        "user",
        "device",
        "session",
        "supportedSnapshotSchemaVersions",
        "managedState"
      ],
      "properties": {
        "deployment": {
          "type": "object",
          "required": [
            "deploymentId",
            "name"
          ],
          "properties": {
            "deploymentId": {
              "$ref": "#/definitions/DeploymentId"
            },
            "name": {
              "type": "string"
            }
          }
        },
        "user": {
          "type": "object",
          "required": [
            "userId",
            "displayName"
          ],
          "properties": {
            "userId": {
              "$ref": "#/definitions/UserId"
            },
            "displayName": {
              "type": "string"
            }
          }
        },
        "device": {
          "type": "object",
          "required": [
            "deviceId",
            "status"
          ],
          "properties": {
            "deviceId": {
              "$ref": "#/definitions/DeviceId"
            },
            "status": {
              "type": "string",
              "enum": [
                "ACTIVE",
                "REVOKED"
              ]
            }
          }
        },
        "session": {
          "type": "object",
          "required": [
            "sessionId",
            "expiresAt",
            "sessionIdleExpiresAt"
          ],
          "properties": {
            "sessionId": {
              "$ref": "#/definitions/SessionId"
            },
            "expiresAt": {
              "type": "string",
              "format": "date-time"
            },
            "sessionIdleExpiresAt": {
              "type": "string",
              "format": "date-time"
            }
          }
        },
        "supportedSnapshotSchemaVersions": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "managedState": {
          "$ref": "#/definitions/ManagedState"
        }
      }
    },
    "ManagedState": {
      "type": "object",
      "required": [
        "runtimeStatus",
        "activeManagedGeneration",
        "managedStateRevision",
        "syncRequired",
        "runtimeBlocked"
      ],
      "properties": {
        "runtimeStatus": {
          "type": "string",
          "enum": [
            "READY",
            "ACTIVATING",
            "DEGRADED"
          ]
        },
        "activeManagedGeneration": {
          "type": "integer",
          "minimum": 0
        },
        "managedStateRevision": {
          "type": "integer",
          "minimum": 0
        },
        "syncRequired": {
          "type": "boolean"
        },
        "targetManagedGeneration": {
          "type": "integer",
          "minimum": 1
        },
        "runtimeBlocked": {
          "type": "boolean"
        }
      }
    },
    "ManagedSnapshot": {
      "type": "object",
      "required": [
        "deploymentId",
        "schemaVersion",
        "managedGeneration",
        "releaseId",
        "snapshotHash",
        "providers",
        "models",
        "tts",
        "asr",
        "mcp",
        "policy",
        "metadata",
        "assistants",
        "starters"
      ],
      "properties": {
        "webdav": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/WebDAVDefinition"
          }
        },
        "deploymentId": {
          "$ref": "#/definitions/DeploymentId"
        },
        "schemaVersion": {
          "type": "integer",
          "enum": [
            5
          ]
        },
        "managedGeneration": {
          "type": "integer",
          "minimum": 1
        },
        "releaseId": {
          "$ref": "#/definitions/ReleaseId"
        },
        "snapshotHash": {
          "$ref": "#/definitions/Sha256Hash"
        },
        "providers": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ProviderDefinition"
          }
        },
        "models": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ModelDefinition"
          }
        },
        "imageGenerators": {
          "type": "array",
          "description": "Additive Snapshot v4 field; omission means an empty list.",
          "items": {
            "$ref": "#/definitions/ImageGenerationDefinition"
          }
        },
        "tts": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/TtsDefinition"
          }
        },
        "asr": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/AsrDefinition"
          }
        },
        "mcp": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/McpDefinition"
          }
        },
        "policy": {
          "$ref": "#/definitions/ManagedPolicy"
        },
        "metadata": {
          "type": "object",
          "required": [
            "publishedAt"
          ],
          "properties": {
            "publishedAt": {
              "type": "string",
              "format": "date-time"
            },
            "publishedByUserId": {
              "$ref": "#/definitions/UserId"
            }
          }
        },
        "assistants": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ManagedAssistantDefinition"
          }
        },
        "starters": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/AssistantStarterDefinition"
          }
        }
      }
    },
    "WebDAVDefinition": {
      "type": "object",
      "required": [
        "resourceId",
        "displayName",
        "enabled",
        "clientProtocol",
        "authOwnership",
        "rootPathTemplate",
        "purpose"
      ],
      "properties": {
        "resourceId": {
          "$ref": "#/definitions/DAVResourceId"
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "enabled": {
          "type": "boolean"
        },
        "purpose": {
          "type": "string",
          "enum": [
            "WORKSPACE_FILE_EXCHANGE"
          ]
        },
        "clientProtocol": {
          "type": "string",
          "enum": [
            "WEBDAV"
          ]
        },
        "authOwnership": {
          "type": "string",
          "enum": [
            "ENTERPRISE_MANAGED"
          ]
        },
        "rootPathTemplate": {
          "type": "string",
          "pattern": "^/runtime/v1/resources/dav_[0-9a-f-]{36}/spaces/\\{agentSpaceId\\}/dav/$"
        }
      }
    },
    "DAVResourceId": {
      "type": "string",
      "pattern": "^dav_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "ReleaseId": {
      "type": "string",
      "pattern": "^rel_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "Sha256Hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "ProviderDefinition": {
      "type": "object",
      "required": [
        "providerId",
        "displayName",
        "clientProtocol",
        "enabled"
      ],
      "properties": {
        "providerId": {
          "$ref": "#/definitions/ProviderId"
        },
        "displayName": {
          "type": "string",
          "minLength": 1
        },
        "clientProtocol": {
          "type": "string",
          "enum": [
            "OPENAI_CHAT_COMPLETIONS",
            "OPENAI_RESPONSES",
            "GOOGLE_GENERATE_CONTENT",
            "ANTHROPIC_MESSAGES"
          ]
        },
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "ProviderId": {
      "type": "string",
      "pattern": "^prv_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "ModelDefinition": {
      "type": "object",
      "required": [
        "modelId",
        "providerId",
        "displayName",
        "upstreamModelKey",
        "runtimePath",
        "inputModalities",
        "outputModalities",
        "capabilities",
        "enabled"
      ],
      "properties": {
        "modelId": {
          "$ref": "#/definitions/ModelId"
        },
        "providerId": {
          "$ref": "#/definitions/ProviderId"
        },
        "displayName": {
          "type": "string",
          "minLength": 1
        },
        "upstreamModelKey": {
          "type": "string",
          "minLength": 1
        },
        "runtimePath": {
          "type": "string",
          "pattern": "^/[^?#]*$"
        },
        "inputModalities": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": [
              "TEXT",
              "IMAGE"
            ]
          }
        },
        "outputModalities": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": [
              "TEXT"
            ]
          }
        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "TOOL",
              "REASONING"
            ]
          }
        },
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "ModelId": {
      "type": "string",
      "pattern": "^mdl_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "ImageGenerationDefinition": {
      "type": "object",
      "required": [
        "imageId",
        "displayName",
        "clientProtocol",
        "upstreamModelKey",
        "runtimePath",
        "maxImagesPerRequest",
        "allowedSizes",
        "enabled"
      ],
      "properties": {
        "imageId": {
          "$ref": "#/definitions/ImageGenerationId"
        },
        "displayName": {
          "type": "string",
          "minLength": 1
        },
        "clientProtocol": {
          "type": "string",
          "enum": [
            "OPENAI_IMAGES_GENERATIONS",
            "DASHSCOPE_MULTIMODAL_GENERATION"
          ]
        },
        "upstreamModelKey": {
          "type": "string",
          "minLength": 1
        },
        "runtimePath": {
          "type": "string",
          "pattern": "^/[^?#]*$"
        },
        "maxImagesPerRequest": {
          "type": "integer",
          "minimum": 1,
          "maximum": 6
        },
        "allowedSizes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^(auto|[1-9][0-9]*x[1-9][0-9]*)$"
          }
        },
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "ImageGenerationId": {
      "type": "string",
      "pattern": "^img_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "TtsDefinition": {
      "type": "object",
      "required": [
        "ttsId",
        "displayName",
        "clientProtocol",
        "enabled"
      ],
      "properties": {
        "ttsId": {
          "$ref": "#/definitions/TtsId"
        },
        "displayName": {
          "type": "string",
          "minLength": 1
        },
        "clientProtocol": {
          "type": "string",
          "enum": [
            "OPENAI_AUDIO_SPEECH",
            "GEMINI_GENERATE_CONTENT_TTS",
            "MIMO_CHAT_COMPLETIONS_TTS",
            "SYSTEM_TTS"
          ]
        },
        "upstreamModelKey": {
          "type": "string",
          "minLength": 1,
          "x-go-type-skip-optional-pointer": true
        },
        "voice": {
          "type": "string",
          "minLength": 1,
          "x-go-type-skip-optional-pointer": true
        },
        "runtimePath": {
          "type": "string",
          "pattern": "^/[^?#]*$",
          "x-go-type-skip-optional-pointer": true
        },
        "voiceDesignPrompt": {
          "type": "string",
          "minLength": 1,
          "x-go-type-skip-optional-pointer": true
        },
        "speechRate": {
          "type": "number",
          "format": "double",
          "exclusiveMinimum": 0
        },
        "pitch": {
          "type": "number",
          "format": "double",
          "exclusiveMinimum": 0
        },
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "TtsId": {
      "type": "string",
      "pattern": "^tts_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "AsrDefinition": {
      "type": "object",
      "required": [
        "asrId",
        "displayName",
        "clientProtocol",
        "upstreamModelKey",
        "runtimePath",
        "enabled"
      ],
      "properties": {
        "asrId": {
          "$ref": "#/definitions/AsrId"
        },
        "displayName": {
          "type": "string",
          "minLength": 1
        },
        "clientProtocol": {
          "type": "string",
          "enum": [
            "OPENAI_AUDIO_TRANSCRIPTIONS",
            "DASHSCOPE_HTTP_ASR",
            "OPENAI_REALTIME_TRANSCRIPTION",
            "DASHSCOPE_REALTIME_ASR"
          ]
        },
        "upstreamModelKey": {
          "type": "string",
          "minLength": 1
        },
        "language": {
          "type": "string",
          "minLength": 1
        },
        "sampleRate": {
          "type": "integer",
          "enum": [
            8000,
            16000,
            24000
          ]
        },
        "vadThreshold": {
          "type": "number",
          "format": "double",
          "minimum": 0,
          "maximum": 1
        },
        "silenceDurationMs": {
          "type": "integer",
          "minimum": 1
        },
        "prefixPaddingMs": {
          "type": "integer",
          "minimum": 0
        },
        "prompt": {
          "type": "string",
          "minLength": 1
        },
        "runtimePath": {
          "type": "string",
          "pattern": "^/[^?#]*$"
        },
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "AsrId": {
      "type": "string",
      "pattern": "^asr_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "McpDefinition": {
      "type": "object",
      "required": [
        "mcpServerId",
        "displayName",
        "clientProtocol",
        "runtimePath",
        "authOwnership",
        "enabled",
        "allowedTools",
        "toolAccessMode"
      ],
      "properties": {
        "mcpServerId": {
          "$ref": "#/definitions/McpServerId"
        },
        "displayName": {
          "type": "string",
          "minLength": 1
        },
        "clientProtocol": {
          "type": "string",
          "enum": [
            "MCP_STREAMABLE_HTTP"
          ]
        },
        "runtimePath": {
          "type": "string",
          "pattern": "^/[^?#]*$"
        },
        "authOwnership": {
          "type": "string",
          "enum": [
            "ENTERPRISE_MANAGED",
            "NONE"
          ]
        },
        "enabled": {
          "type": "boolean"
        },
        "toolAccessMode": {
          "description": "ALL follows dynamic discovery without additional invocation confirmation or published-contract hash locking; ALLOWLIST restricts to a nonempty reviewed list with explicit per-tool approval policy.",
          "type": "string",
          "enum": [
            "ALL",
            "ALLOWLIST"
          ]
        },
        "allowedTools": {
          "type": "array",
          "x-uniqueProperty": "name",
          "items": {
            "$ref": "#/definitions/McpToolGrant"
          }
        }
      }
    },
    "McpServerId": {
      "type": "string",
      "pattern": "^mcp_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "McpToolGrant": {
      "type": "object",
      "required": [
        "name",
        "contractHash",
        "approvalPolicy"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^*]+$"
        },
        "contractHash": {
          "$ref": "#/definitions/Sha256Hash"
        },
        "approvalPolicy": {
          "description": "AUTO adds no enterprise confirmation; REQUIRE_CONFIRMATION requires user approval before each invocation. Independent of tool selection and does not bypass existing runtime or system permissions. Required explicitly; no decoder default.",
          "type": "string",
          "enum": [
            "AUTO",
            "REQUIRE_CONFIRMATION"
          ]
        }
      }
    },
    "ManagedPolicy": {
      "type": "object",
      "description": "Current policy. All five admission flags are required; all ten defaults are optional and remain unset when omitted.",
      "required": [
        "policyId",
        "allowLocalProviders",
        "allowLocalTts",
        "allowLocalAsr",
        "allowLocalMcp",
        "allowLocalAssistants"
      ],
      "properties": {
        "policyId": {
          "$ref": "#/definitions/PolicyId"
        },
        "allowLocalProviders": {
          "type": "boolean"
        },
        "allowLocalTts": {
          "type": "boolean"
        },
        "allowLocalAsr": {
          "type": "boolean"
        },
        "allowLocalMcp": {
          "type": "boolean"
        },
        "allowLocalAssistants": {
          "type": "boolean",
          "description": "Allows user assistants; referenced resources remain independently governed."
        },
        "defaultModelId": {
          "$ref": "#/definitions/ModelId"
        },
        "defaultFastModelId": {
          "$ref": "#/definitions/ModelId"
        },
        "defaultTitleModelId": {
          "$ref": "#/definitions/ModelId"
        },
        "defaultAttachmentInspectionModelId": {
          "$ref": "#/definitions/ModelId"
        },
        "defaultSuggestionModelId": {
          "$ref": "#/definitions/ModelId"
        },
        "defaultCompressModelId": {
          "$ref": "#/definitions/ModelId"
        },
        "defaultImageGenerationId": {
          "$ref": "#/definitions/ImageGenerationId"
        },
        "defaultTtsId": {
          "$ref": "#/definitions/TtsId"
        },
        "defaultAsrId": {
          "$ref": "#/definitions/AsrId"
        },
        "defaultAssistantId": {
          "$ref": "#/definitions/AssistantDefinitionId"
        }
      }
    },
    "PolicyId": {
      "type": "string",
      "pattern": "^pol_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
